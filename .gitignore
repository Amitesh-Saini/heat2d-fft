# HDF5 test artifacts (regenerated by tests/test_hdf5_writer.cpp)
probe*.h5

# Simulation outputs and generated figures (regenerable; keep the folder
# structure so a fresh clone can run without creating directories by hand)
output/data/*
output/figures/*
!output/data/.gitkeep
!output/figures/.gitkeep

# Committed showcase run: the two-mode Fourier case has an analytic solution,
# so its figures are evidence rather than illustration. Everything else is
# regenerated by running the solver.
!output/data/heat_multi_mode.h5
!output/figures/multi_fourier_mode/
output/figures/multi_fourier_mode/**
!output/figures/multi_fourier_mode/**/
!output/figures/multi_fourier_mode/heat_multi_mode/*.png
!output/figures/multi_fourier_mode/heat_multi_mode/surface_animation.gif

# Benchmark output
benchmarks/results/fftw_wisdom.dat
benchmarks/results/**/*.pdf

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/compile_commands.json
compile_commands.json
