{
    "schema_version": 1,
  
    "solver": {
      "nx": 256,
      "ny": 256,
      "Lx": 2.0,
      "Ly": 2.0,
      "alpha": 1.0
    },
  
    "fft_backend": "fftw",
  
    "initial_condition": {
      "type": "multi_fourier_mode",
      "modes": [
        { "kx": 1,  "ky": 0,  "amplitude": 1.0,  "phase": 0.0 },
        { "kx": 0,  "ky": 1,  "amplitude": 0.8,  "phase": 0.0 },
        { "kx": 3,  "ky": 2,  "amplitude": 0.5,  "phase": 0.0 },
        { "kx": -2, "ky": 5,  "amplitude": 0.4,  "phase": 1.5707963267948966 },
        { "kx": 8,  "ky": 8,  "amplitude": 0.3,  "phase": 0.0 },
        { "kx": 16, "ky": -4, "amplitude": 0.2,  "phase": 0.0 }
      ]
    },
  
    "time": {
      "mode": "uniform",
      "t_start": 0.0,
      "t_end": 0.25,
      "num_snapshots": 60
    },
  
    "output": {
      "output_path": "output/data/fftw_heat_multi_mode.h5",
      "overwrite": true,
      "gzip_level": 4
    },
  
    "diagnostics": {
      "enabled": true,
      "compute_analytic_error": true
    }
  }