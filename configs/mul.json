{
    "schema_version": 1,
  
    "solver": {
      "nx": 1024,
      "ny": 1024,
      "Lx": 2.0,
      "Ly": 2.0,
      "alpha": 1.0
    },
  
    "fft_backend": "custom",
  
    "initial_condition": {
      "type": "multi_fourier_mode",
      "modes": [
        { "kx": 1,  "ky": 0,  "amplitude": 1.0,  "phase": 0.0 },
        { "kx": 0,  "ky": 1,  "amplitude": 1.0,  "phase": 0.0 },
        { "kx": 1,  "ky": 1,  "amplitude": 1.0,  "phase": 0.0 }
      ]
    },
  
    "time": {
      "mode": "uniform",
      "t_start": 0.0,
      "t_end": 0.25,
      "num_snapshots": 60
    },
  
    "output": {
      "output_path": "output/data/mul.h5",
      "overwrite": true,
      "gzip_level": 4
    },
  
    "diagnostics": {
      "enabled": true,
      "compute_analytic_error": true
    }
  }