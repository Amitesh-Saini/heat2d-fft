{
    "schema_version": 1,
  
    "solver": {
      "nx": 256,
      "ny": 256,
      "Lx": 2.0,
      "Ly": 2.0,
      "alpha": 1.0
    },
  
    "fft_backend": "custom",
  
    "initial_condition": {
      "type": "single_fourier_mode",
      "kx": 2,
      "ky": 1,
      "amplitude": 1.0,
      "phase": 0.0
    },
  
    "time": {
      "mode": "uniform",
      "t_start": 0.0,
      "t_end": 0.15,
      "num_snapshots": 60
    },
  
    "output": {
      "output_path": "output/data/heat_single_mode.h5",
      "overwrite": true,
      "gzip_level": 4
    },
  
    "diagnostics": {
      "enabled": true,
      "compute_analytic_error": true
    }
  }